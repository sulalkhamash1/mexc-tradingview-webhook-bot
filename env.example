# MEXC API Credentials
# Get your API keys from: https://www.mexc.com/user/openapi
# IMPORTANT: Never commit your actual .env file to GitHub

MEXC_API_KEY=your_mexc_api_key_here
MEXC_SECRET_KEY=your_mexc_secret_key_here
MEXC_BASE_URL=https://futures.mexc.com

# Trading Configuration
DEFAULT_SYMBOL=BNB_USDT
DEFAULT_LEVERAGE=5
DEFAULT_VOLUME=1

# Server Configuration
WEBHOOK_PORT=5000

# Optional: Add a secret token to verify webhook requests
WEBHOOK_SECRET=
